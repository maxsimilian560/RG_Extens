  "Mode: parser": {
    "prefix": "parser",
    "body": "parser",
    "description": "Include module parser"
  },
  "Mode: mem_limit": {
    "prefix": "mem_limit",
    "body": "mem_limit",
    "description": "Include module mem_limit"
  },
  "Mode: debug_always_update": {
    "prefix": "debug_always_update",
    "body": "debug_always_update",
    "description": "Include module debug_always_update"
  },
  "Mode: pause": {
    "prefix": "pause",
    "body": "pause",
    "description": "Include module pause"
  },
  "Mode: no_useless_warning": {
    "prefix": "no_useless_warning",
    "body": "no_useless_warning",
    "description": "Include module no_useless_warning"
