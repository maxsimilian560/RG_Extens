  },
  "Mode: web_server": {
    "prefix": "web_server",
    "body": "web_server",
    "description": "Include module web_server"
  },
  "Mode: joystick": {
    "prefix": "joystick",
    "body": "joystick",
    "description": "Include module joystick"
  },
  "Mode: mod_manager": {
    "prefix": "mod_manager",
    "body": "mod_manager",
    "description": "Include module mod_manager"
  },
  "Mode: useless_addon": {
    "prefix": "useless_addon",
    "body": "useless_addon",
    "description": "Include module useless_addon"
  },
  "Mode: pov_cam": {
    "prefix": "pov_cam",
    "body": "pov_cam",
    "description": "Include module pov_cam"
  },
  "Mode: lang": {
    "prefix": "lang",
    "body": "lang",
    "description": "Include module lang"
  },
  "Mode: player": {
    "prefix": "player",
    "body": "player",
    "description": "Include module player"
