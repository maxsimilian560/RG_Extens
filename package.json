{
  "publisher": "maxsimilian560",
  "name": "rg-extens",
  "displayName": "RG_Extens",
  "description": "Extension for the Rinegine engine. Adds syntax for core engine files such as rgset and rgobj. This also helps configure VS code to work correctly with Rinegine",
  "version": "0.1.10",
  "engines": {
    "vscode": "^1.108.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Maximilian560/RG_Extens.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "RG_Extens Configuration",
      "properties": {
        "rg-extens.rineginePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Rinegine engine."
        },
        "rg-extens.focusTerminalOnBuild": {
        "type": "boolean",
        "default": true,
        "description": "Move focus to terminal when running build."
        },
        "rg-extens.openTerminalOnBuild": {
        "type": "boolean",
        "default": true,
        "description": "Open terminal when running build."
        }
      }
    },
    "commands": [
      {
        "command": "rg-extens.buildEngine64",
        "title": "Build (64-bit)"
      },
      {
        "command": "rg-extens.buildEngine32",
        "title": "Build (32-bit)"
      },
      {
        "command": "rg-extens.setRineginePath",
        "title": "Set Rinegine path"
      },
      {
        "command": "rg-extens.deleteRinegineVariable",
        "title": "Reset Rinegine path"
      }
    ],
    "keybindings": [
      {
        "command": "rg-extens.buildEngine32",
        "key": "ctrl+f8",
        "when": "editorTextFocus"
      },
      {
        "command": "rg-extens.buildEngine64",
        "key": "",
        "when": "editorTextFocus"
      }
    ],
    "languages": [
      {
        "id": "rgset",
        "extensions": [
          ".rgset"
        ],
        "filenames": [
          "rgset"
        ],
        "aliases": [
          "rgset"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rgset",
        "scopeName": "source.rgset",
        "path": "./syntaxes/rgset.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rgset",
        "path": "./snippets/rgset.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.1.0",
    "@types/vscode": "^1.108.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "glob": "^10.5.0",
    "qs": "^6.14.1",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "diff": "^8.0.3"
  }
}
