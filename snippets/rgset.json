  "Mode: console": {
    "prefix": "console",
    "body": "console",
    "description": "Enables console output"
  },
  "Mode: other_cmd": {
    "prefix": "other_cmd",
    "body": "other_cmd",
    "description": "Runs the program in a new CMD window"
  },
  "Mode: utf": {
    "prefix": "utf",
    "body": "utf",
    "description": "Enables UTF encoding"
  },
  "Mode: createlib": {
    "prefix": "createlib",
    "body": "createlib",
    "description": "Creates a library instead of an executable"
  },
  "Mode: debug": {
    "prefix": "debug",
    "body": "debug",
    "description": "Enables debug mode"
  },
  "Mode: shared": {
    "prefix": "shared",
    "body": "shared",
    "description": "Creates a shared (dynamic) library"
  },
  "Mode: static": {
    "prefix": "static",
    "body": "static",
    "description": "Creates a static library"
  },
  "Mode: asm": {
    "prefix": "asm",
    "body": "asm",
    "description": "Enables assembling of assembler files"
  },
  "Mode: clear": {
    "prefix": "clear",
    "body": "clear",
    "description": "Clears almost all variables and modes"
  },
  "Variable: name": {
    "prefix": "name",
    "body": "name = \"$1\"",
    "description": "Sets the name for the 64-bit output file"
  },
  "Variable: name32": {
    "prefix": "name32",
    "body": "name32 = \"{NAME}-x32\"",
    "description": "Sets the name for the 32-bit output file"
  },
  "Variable: bit": {
    "prefix": "bit",
    "body": "bit = $1",
    "description": "Sets the bit depth (32, 64, all)"
  },
  "Variable: resource": {
    "prefix": "resource",
    "body": "resource = \"$1\"",
    "description": "Sets the resource file (e.g., resource.rc)"
  },
  "Variable: source": {
    "prefix": "source",
    "body": "source = \"$1\"",
    "description": "Specifies the .cpp file for compilation"
  },
  "Variable: run": {
    "prefix": "run",
    "body": "run = $1",
    "description": "Run after compilation (32, 64, false)"
  },
  "Variable: compilator": {
    "prefix": "compilator",
    "body": "compilator = \"{RINEGINE_FOL}\\\\compiler\\\\mingw64\\\\bin\\\\g++\"",
    "description": "Path to the 64-bit compiler"
  },
  "Variable: compilator32": {
    "prefix": "compilator32",
    "body": "compilator32 = \"{RINEGINE_FOL}\\\\compiler\\\\mingw32\\\\bin\\\\g++\"",
    "description": "Path to the 32-bit compiler"
  },
  "Variable: libs": {
    "prefix": "libs",
    "body": "libs = \"$1\"",
    "description": "Linker flags for 64-bit libraries"
  },
  "Variable: libs32": {
    "prefix": "libs32",
    "body": "libs32 = \"$1\"",
    "description": "Linker flags for 32-bit libraries"
  },
  "Variable: include": {
    "prefix": "include",
    "body": "include = \"$1\"",
    "description": "Compiler include flags for 64-bit"
  },
  "Variable: include32": {
    "prefix": "include32",
    "body": "include32 = \"$1\"",
    "description": "Compiler include flags for 32-bit"
  },
  "Variable: flags": {
    "prefix": "flags",
    "body": "flags = \"$1\"",
    "description": "Compiler flags for 64-bit"
  },
  "Variable: flags32": {
    "prefix": "flags32",
    "body": "flags32 = \"$1\"",
    "description": "Compiler flags for 32-bit"
  },
  "Variable: link": {
    "prefix": "link",
    "body": "link = \"$1\"",
    "description": "Linker flags for 64-bit"
  },
  "Variable: link32": {
    "prefix": "link32",
    "body": "link32 = \"{LINK}\"",
    "description": "Linker flags for 32-bit"
  },
  "Variable: extension": {
    "prefix": "extension",
    "body": "extension = \"$1\"",
    "description": "File extension for the output file"
  },
  "Value: true": {
    "prefix": "true",
    "body": "true",
    "description": "Boolean true"
  },
  "Value: false": {
    "prefix": "false",
    "body": "false",
    "description": "Boolean false"
  },
  "Value: 32": {
    "prefix": "32",
    "body": "32",
    "description": "32-bit value"
  },
  "Value: 64": {
    "prefix": "64",
    "body": "64",
    "description": "64-bit value"
  },
  "Value: all": {
    "prefix": "all",
    "body": "all",
    "description": "All bit depths"
  },
