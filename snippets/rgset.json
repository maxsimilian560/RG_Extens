{
  "Basic rgset configuration": {
    "prefix": "rgset",
    "body": [
      "set {",
      "  mode {",
      "    $1",
      "  },",
      "  var {",
      "    $2",
      "  }",
      "}"
    ],
    "description": "Basic rgset configuration template"
  },
  "Mode: module": {
    "prefix": "module",
    "body": "module{$1}",
    "description": "Body to include modules"
  },
  "Mode: set": {
    "prefix": "set",
    "body": "set{$1}",
    "description": "Body to main vars and modes"
  },
  "Mode: var": {
    "prefix": "var",
    "body": "var{$1}",
    "description": "Body into set, main to variables"
  },
  "Mode: mods": {
    "prefix": "mods",
    "body": "mode{$1}",
    "description": "Body into set, main to mods"
  },
  "Mode: add": {
    "prefix": "add",
    "body": "add{$1}",
    "description": "Like set, but add"
  },
  "Mode: graph": {
    "prefix": "graph",
    "body": "graph",
    "description": "Include module graph"
  },
  "Mode: addons": {
    "prefix": "addons",
    "body": "addons",
    "description": "Include module addons"
  },
  "Mode: network": {
    "prefix": "network",
    "body": "network",
    "description": "Include module network"
  },
  "Mode: sound": {
    "prefix": "sound",
    "body": "sound",
    "description": "Include module sound"
  },
  "Mode: neural": {
    "prefix": "neural",
    "body": "neural",
    "description": "Include module neural"
  },
  "Mode: experemental": {
    "prefix": "experemental",
